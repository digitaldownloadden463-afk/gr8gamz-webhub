# GR8 GAMZ Environment Configuration
# Copy this file to .env.local and fill in your values

# Canonical production URL
NEXT_PUBLIC_SITE_URL=https://www.gr8gamz.com

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QYTP57SB11
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-9245359017496056
# Keep false until AdSense approval and the Google CMP cutover are production-verified.
NEXT_PUBLIC_GOOGLE_ADSENSE_ENABLED=false

# API endpoints (if backend integration needed)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Partner feeds
GAMEPIX_SID=8G856
NEXT_PUBLIC_GAMEPIX_SID=8G856

# Vercel production persistence
GR8_SESSION_SECRET=
GR8_ADMIN_KEY=
GR8_BACKEND_ENDPOINT=
GR8_BACKEND_TOKEN=
GR8_DATABASE_URL=
DATABASE_URL=
POSTGRES_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_LEADERBOARD=true
NEXT_PUBLIC_ENABLE_PASSPORT=true
