# GR8 GAMZ Environment Configuration
# Copy this file to .env.local and fill in your values

# Canonical production URL
NEXT_PUBLIC_SITE_URL=https://www.gr8gamz.com

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YL11VWGQM6
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-9245359017496056
# Loads Google's tag and certified CMP; Google still controls site approval and ad fill.
NEXT_PUBLIC_GOOGLE_ADSENSE_ENABLED=true
# Public ad-unit identifiers created in the GR8 GAMZ AdSense account.
NEXT_PUBLIC_GOOGLE_ADSENSE_HOME_SLOT=7441357346
NEXT_PUBLIC_GOOGLE_ADSENSE_DISCOVERY_SLOT=8147049877
NEXT_PUBLIC_GOOGLE_ADSENSE_EDITORIAL_SLOT=5520886535
# Preview/local smoke only. Production must remain false.
NEXT_PUBLIC_GOOGLE_ADSENSE_TEST_MODE=false

# API endpoints (if backend integration needed)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Partner feeds
GAMEPIX_SID=8G856
NEXT_PUBLIC_GAMEPIX_SID=8G856

# Vercel production persistence
GR8_SESSION_SECRET=
GR8_ADMIN_KEY=
GR8_BACKEND_ENDPOINT=
GR8_BACKEND_TOKEN=
GR8_DATABASE_URL=
DATABASE_URL=
POSTGRES_URL=

# Feature flags
NEXT_PUBLIC_ENABLE_LEADERBOARD=true
NEXT_PUBLIC_ENABLE_PASSPORT=true
