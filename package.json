{
  "name": "gr8gamz-webhub",
  "version": "2.0.1",
  "description": "GR8 GAMZ - A premium HTML5 arcade game hub with 25+ free browser games",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "ingest:partners": "node scripts/ingest-partner-catalogue.mjs",
    "validate:games": "node scripts/validate-games.mjs",
    "validate:partners": "node scripts/validate-partner-catalogue.mjs",
    "validate:providers": "node scripts/validate-provider-urls.mjs",
    "validate:artwork": "node scripts/validate-artwork-urls.mjs",
    "validate:content-integrity": "node scripts/validate-content-integrity.mjs",
    "validate:rendered-link-graph": "node scripts/validate-rendered-link-graph.mjs",
    "validate:sitemap-truth": "node scripts/validate-sitemap-truth.mjs",
    "test": "pnpm run validate:games && pnpm run validate:partners && pnpm run validate:providers && pnpm run validate:i18n && pnpm run validate:seo-engine && pnpm run validate:content-integrity && pnpm run audit:routes && pnpm run validate:discovery && pnpm run check:bundle-size",
    "audit:routes": "node scripts/audit-routes.mjs",
    "validate:discovery": "node scripts/validate-discovery.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:seo-engine": "node scripts/validate-seo-engine.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "smoke:playwright": "node scripts/playwright-smoke.mjs",
    "smoke:artwork": "node scripts/artwork-browser-smoke.mjs",
    "smoke:gameplay-consent": "node scripts/gameplay-consent-smoke.mjs",
    "smoke:phase3a1": "node scripts/phase3a1-responsive-smoke.mjs",
    "smoke:phase3b": "node scripts/phase3b-engagement-smoke.mjs",
    "smoke:games-query": "node scripts/games-query-smoke.mjs",
    "crawl:routes": "node scripts/crawl-routes.mjs",
    "sample:partners": "node scripts/sample-partner-pages.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:i18n": "node scripts/smoke-localized-pages.mjs",
    "lhci": "node scripts/lighthouse-ci.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "lighthouse": "^13.4.1",
    "prettier": "^3.1.0",
    "typescript": "5.9.3"
  }
}
